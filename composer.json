{
    "name": "mass/paginaweb",
    "description": "Mass Online - Tiendas Mass (PHP nativo XAMPP) — práctica Pruebas y Calidad de Software",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5.50"
    },
    "autoload": {
        "files": [
            "backend/bootstrap.php",
            "includes/data.php",
            "includes/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:coverage": "@php tests/run_coverage.php"
    },
    "config": {
        "audit": {
            "block-insecure": true
        }
    }
}
