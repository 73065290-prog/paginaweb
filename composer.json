{
    "name": "mass/paginaweb",
    "description": "Mass Online - Tiendas Mass (PHP nativo XAMPP) — práctica Pruebas y Calidad de Software",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5"
    },
    "autoload": {
        "files": [
            "includes/data.php",
            "includes/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:coverage": "@php -d extension=pcov -d pcov.enabled=1 vendor/bin/phpunit --coverage-text --coverage-clover=docs/pruebas/evidencias/coverage/clover.xml --coverage-html=docs/pruebas/evidencias/coverage/html --log-junit=docs/pruebas/evidencias/junit.xml --testdox-html=docs/pruebas/evidencias/testdox.html"
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
